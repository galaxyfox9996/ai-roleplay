# Copy this file to .env and fill only one provider block at a time.
# Real environment variables override values in .env.

HOST=127.0.0.1
PORT=7860

# Provider options:
#   ollama
#   openai
#   gpt
#   deepseek
#   openai-compatible
#   fallback
MODEL_PROVIDER=ollama
MODEL_NAME=llama3.1
MODEL_TEMPERATURE=0.75
MODEL_MAX_TOKENS=900
MODEL_TIMEOUT_SECONDS=45

# Prompt budget controls
PROMPT_RECENT_MESSAGE_LIMIT=8
PROMPT_WORLD_ENTRY_LIMIT=6
PROMPT_MAX_CHARS=18000
SUMMARY_UPDATE_INTERVAL=4
SUMMARY_MAX_CHARS=4000

# Ollama
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434/api/generate

# OpenAI / GPT
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek
# MODEL_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI-compatible providers:
# Use this for OpenRouter, DashScope/Qwen-compatible gateways, SiliconFlow,
# Moonshot/Kimi-compatible gateways, Zhipu-compatible gateways, local vLLM,
# LiteLLM, LM Studio, and similar /chat/completions services.
# MODEL_PROVIDER=openai-compatible
# MODEL_NAME=provider-model-name
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_API_KEY=your-api-key-if-needed

# Some compatible providers do not support response_format.
# OPENAI_RESPONSE_FORMAT=none
